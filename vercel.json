{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/favicon.(ico|svg|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/favicon-(.*).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ],
  "redirects": [
    { "source": "/conform.studio", "destination": "/", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "get.conform.studio" }], "destination": "https://www.haste.nyc/free90", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "conform.studio" }], "destination": "https://www.haste.nyc/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.conform.studio" }], "destination": "https://www.haste.nyc/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "haste.nyc" }], "destination": "https://www.haste.nyc/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily-analytics", "schedule": "0 3 * * *" },
    { "path": "/api/cron/check-api-keys", "schedule": "0 13 * * *" },
    { "path": "/api/cron/detect-duplicate-subs", "schedule": "0 14 * * *" }
  ]
}
